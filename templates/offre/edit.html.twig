{% extends 'base.html.twig' %}

{% block title %}Modifier {{ offer.title }}{% endblock %}

{% block body %}
<div class="form-page">
    {{ form_start(form, {'attr': {'class': 'company-form'}}) }}
        <div class="form-header">
            <div class="back-link">
                <a href="{{ path('offre_show', {'id': offer.id}) }}">
                    <i class="fas fa-arrow-left"></i> Retour à l'offre
                </a>
            </div>
            <h1>Modifier l'offre de stage</h1>
        </div>

        <div class="form-section">
            <h2>Informations générales</h2>
            <div class="form-group">
                {{ form_label(form.title) }}
                {{ form_widget(form.title) }}
                {{ form_errors(form.title) }}
            </div>

            <div class="form-group">
                {{ form_label(form.description) }}
                {{ form_widget(form.description) }}
                {{ form_errors(form.description) }}
            </div>
        </div>

        <div class="form-section">
            <h2>Détails du stage</h2>
            <div class="form-row">
                <div class="form-group">
                    {{ form_label(form.startDate) }}
                    {{ form_widget(form.startDate) }}
                    {{ form_errors(form.startDate) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.endDate) }}
                    {{ form_widget(form.endDate) }}
                    {{ form_errors(form.endDate) }}
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    {{ form_label(form.remuneration) }}
                    {{ form_widget(form.remuneration) }}
                    {{ form_errors(form.remuneration) }}
                </div>

                {% if form.company is defined %}
                <div class="form-group">
                    {{ form_label(form.company) }}
                    {{ form_widget(form.company) }}
                    {{ form_errors(form.company) }}
                </div>
                {% endif %}
            </div>
        </div>

        <div class="form-section">
            <h2>Compétences requises</h2>
            <div class="form-group">
                {{ form_label(form.skills) }}
                {{ form_widget(form.skills) }}
                {{ form_errors(form.skills) }}
            </div>
        </div>

        <div class="form-section">
            <h2>Statut de l'offre</h2>
            <div class="form-checkbox">
                {{ form_widget(form.isActive) }}
                {{ form_label(form.isActive) }}
                {{ form_errors(form.isActive) }}
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">
                <i class="fas fa-save"></i> Enregistrer les modifications
            </button>
            <a href="{{ path('offre_show', {'id': offer.id}) }}" class="btn-secondary">
                <i class="fas fa-times"></i> Annuler
            </a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialiser Select2 pour les listes déroulantes
        if (typeof $('.select2').select2 === 'function') {
            $('.select2').select2({
                placeholder: 'Sélectionnez des compétences',
                allowClear: true
            });
        }
    });
</script>
{% endblock %}