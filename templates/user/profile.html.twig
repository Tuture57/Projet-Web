{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
<div class="container">
    <h1>Mon Profil</h1>
    
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}
    
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body text-center">
                    <div class="profile-image mb-3">
                        <img src="{{ asset('img/user.png') }}" alt="Photo de profil" class="rounded-circle" width="150">
                    </div>
                    <h5 class="card-title">{{ user.prenom }} {{ user.nom }}</h5>
                    <p class="card-text text-muted">{{ user.role }}</p>
                    <p class="card-text">{{ user.promotion }}</p>
                    <div class="mt-3">
                        <a href="{{ path('user_profile_edit') }}" class="btn btn-primary">Modifier mon profil</a>
                        <a href="{{ path('user_change_password') }}" class="btn btn-outline-secondary mt-2">Changer mon mot de passe</a>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    Informations personnelles
                </div>
                <div class="card-body">
                    <table class="table">
                        <tbody>
                            <tr>
                                <th>Email</th>
                                <td>{{ user.email }}</td>
                            </tr>
                            <tr>
                                <th>Rôle</th>
                                <td>{{ user.role }}</td>
                            </tr>
                            <tr>
                                <th>Promotion</th>
                                <td>{{ user.promotion }}</td>
                            </tr>
                            <tr>
                                <th>Membre depuis</th>
                                <td>{{ user.createdAt|date('d/m/Y') }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            
            <div class="card mt-3">
                <div class="card-header">
                    Activité récente
                </div>
                <div class="card-body">
                    <p>Aucune activité récente.</p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}