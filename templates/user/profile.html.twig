{# filepath: templates/profile/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
<div class="form-page">
    <div class="form-header">
        <h1>Mon Profil</h1>
    </div>
    <div class="form-section">
        <h2>Informations du profil</h2>
        <div class="profile-details">
            <div class="profile-image">
                {% if app.user.image %}
                    <img src="{{ asset('uploads/students/' ~ app.user.image) }}" alt="Photo de profil" class="rounded-circle" width="150">
                {% else %}
                    <img src="{{ asset('img/user.png') }}" alt="Photo de profil" class="rounded-circle" width="150">
                {% endif %}
            </div>
            <div class="profile-info">
                <p><strong>Nom:</strong> {{ app.user.firstName }} {{ app.user.lastName }}</p>
                <p><strong>Email:</strong> {{ app.user.email }}</p>
                {% if app.user.school is defined and app.user.school %}
                    <p><strong>École:</strong> {{ app.user.school.name }}</p>
                {% endif %}
                {% if app.user.promotion is defined and app.user.promotion %}
                    <p><strong>Promotion:</strong> {{ app.user.promotion }}</p>
                {% endif %}
                {% if app.user.campus is defined and app.user.campus %}
                    <p><strong>Campus:</strong> {{ app.user.campus }}</p>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="form-actions">
        {% if is_granted('ROLE_STUDENT') %}
            <a href="{{ path('etudiant_edit', {'id': app.user.id}) }}" class="btn-primary">
                <i class="fas fa-edit"></i> Modifier mon profil
            </a>
        {% endif %}
        <a href="{{ path('notifications') }}" class="btn-secondary">
            <i class="fas fa-bell"></i> Notifications
        </a>
    </div>
</div>
{% endblock %}