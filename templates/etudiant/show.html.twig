{% extends 'base.html.twig' %}

{% block title %}{{ student.firstName }} {{ student.lastName }}{% endblock %}

{% block body %}
<div class="company-header">
    <div class="back-button">
        <a href="{{ path('etudiant') }}"><i class="fas fa-arrow-left"></i> Retour aux étudiants</a>
    </div>
    
    <div class="company-profile">
        <div class="company-logo-container">
            {% include 'partials/_image_display.html.twig' with {
                'entity': student,
                'upload_path': 'uploads/students',
                'alt': student.firstName ~ ' ' ~ student.lastName,
                'image_class': 'company-logo',
                'placeholder_class': 'company-logo-placeholder'
            } %}
        </div>
        
        <div class="company-info">
            <h1>{{ student.firstName }} {{ student.lastName }}</h1>
            
            {% if is_granted('ROLE_PILOT') %}
                <div class="admin-actions">
                    <a href="{{ path('etudiant_edit', {'id': student.id}) }}" class="btn-edit">
                        <i class="fas fa-edit"></i> Modifier
                    </a>
                    
                    <a href="#" class="btn-delete" onclick="confirmDelete({{ student.id }})">
                        <i class="fas fa-trash"></i> Supprimer
                    </a>
                </div>
                
                <form id="delete-form-{{ student.id }}" action="{{ path('etudiant_delete', {'id': student.id}) }}" method="post" style="display: none;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ student.id) }}">
                </form>
            {% endif %}
            
            {% if student.searchStatus %}
                <div class="company-rating">
                    <span class="status-badge 
                        {% if student.searchStatus == 'En recherche' %}status-searching{% endif %}
                        {% if student.searchStatus == 'Stage trouvé' %}status-found{% endif %}
                        {% if student.searchStatus == 'Non disponible' %}status-unavailable{% endif %}
                    ">
                        {{ student.searchStatus }}
                    </span>
                </div>
            {% else %}
                <span class="no-rating">Statut non défini</span>
            {% endif %}
            
            <div class="company-details">
                {% if student.school %}
                    <div class="detail-item">
                        <i class="fas fa-university"></i>
                        <span>{{ student.school }}</span>
                    </div>
                {% endif %}
                
                <div class="detail-item">
                    <i class="fas fa-envelope"></i>
                    <span>{{ student.email }}</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="company-description card">
    <h2>Informations complémentaires</h2>
    <div class="description-content">
        {% if student.address is defined and student.address %}
            <div class="address-section">
                <h3><i class="fas fa-map-marker-alt"></i> Adresse</h3>
                <p>{{ student.address }}</p>
            </div>
        {% endif %}
        
        {% if student.bio is defined and student.bio %}
            <div class="bio-section">
                <h3><i class="fas fa-user"></i> Biographie</h3>
                {{ student.bio|raw }}
            </div>
        {% else %}
            <p>Aucune information complémentaire disponible.</p>
        {% endif %}
    </div>
</div>

<div class="company-offers card">
    <div class="offers-header">
        <h2>Stages</h2>
        
        {% if applications is defined and applications|length > 0 %}
            <div class="offer-filters">
                <div class="filter-label">Filtrer par statut :</div>
                <div class="filter-buttons">
                    {% set current_filters = app.request.query.all()['filters'] is defined ? app.request.query.all()['filters'] : [] %}
                    
                    <a href="{{ path('etudiant_show', {'id': student.id}) }}" 
                       class="filter-btn {% if current_filters is empty %}active{% endif %}">
                        Tous
                    </a>
                    
                    <a href="{{ path('etudiant_show', {
                            'id': student.id, 
                            'filters': 'Pending' in current_filters 
                                ? current_filters|filter(f => f != 'Pending') 
                                : current_filters|merge(['Pending'])
                        }) }}" 
                       class="filter-btn {% if 'Pending' in current_filters %}active{% endif %}">
                        En attente
                    </a>
                    
                    <a href="{{ path('etudiant_show', {
                            'id': student.id, 
                            'filters': 'Accepted' in current_filters 
                                ? current_filters|filter(f => f != 'Accepted') 
                                : current_filters|merge(['Accepted'])
                        }) }}" 
                       class="filter-btn {% if 'Accepted' in current_filters %}active{% endif %}">
                        Acceptés
                    </a>
                    
                    <a href="{{ path('etudiant_show', {
                            'id': student.id, 
                            'filters': 'Rejected' in current_filters 
                                ? current_filters|filter(f => f != 'Rejected') 
                                : current_filters|merge(['Rejected'])
                        }) }}" 
                       class="filter-btn {% if 'Rejected' in current_filters %}active{% endif %}">
                        Refusés
                    </a>
                </div>
            </div>
        {% endif %}
    </div>
    
    {% if applications is defined and applications|length > 0 %}
        <div class="offer-list">
            {% set displayed_applications = false %}
            {% set active_filters = app.request.query.all()['filters'] is defined ? app.request.query.all()['filters'] : [] %}
            
            {% for application in applications %}
                {% if active_filters is empty or application.status in active_filters %}
                    {% set displayed_applications = true %}
                    <div class="offer-item">
                        <div class="offer-header">
                            <h3>{{ application.offer.title }}</h3>
                            <span class="offer-type 
                                {% if application.status == 'Accepted' %}status-accepted{% endif %}
                                {% if application.status == 'Pending' %}status-pending{% endif %}
                                {% if application.status == 'Rejected' %}status-rejected{% endif %}
                            ">
                                {% if application.status == 'Accepted' %}Accepté{% endif %}
                                {% if application.status == 'Pending' %}En attente{% endif %}
                                {% if application.status == 'Rejected' %}Refusé{% endif %}
                            </span>
                        </div>
                        
                        {% if application.offer.company %}
                        <div class="offer-location">
                            <i class="fas fa-building"></i>
                            <span>{{ application.offer.company.name }}</span>
                        </div>
                        {% endif %}
                        
                        <div class="offer-duration">
                            <i class="far fa-clock"></i>
                            <span>
                                {% if application.offer.startDate is defined and application.offer.endDate is defined %}
                                    {{ application.offer.startDate|date('d/m/Y') }} - {{ application.offer.endDate|date('d/m/Y') }}
                                {% else %}
                                    Dates non spécifiées
                                {% endif %}
                            </span>
                        </div>
                        
                        <div class="offer-footer">
                            <span class="offer-date">Postulé le {{ application.applicationDate|date('d/m/Y') }}</span>
                            <a href="{{ path('offre_show', {'id': application.offer.id}) }}" class="btn-view-offer">
                                Voir l'offre <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
            
            {% if not displayed_applications %}
                <div class="no-offers">
                    <i class="far fa-file-alt"></i>
                    <p>Aucun stage ne correspond aux filtres sélectionnés</p>
                </div>
            {% endif %}
        </div>
    {% else %}
        <div class="no-offers">
            <i class="far fa-file-alt"></i>
            <p>Aucun stage pour le moment</p>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
<script>
    function confirmDelete(id) {
        if (confirm('Êtes-vous sûr de vouloir supprimer cet étudiant ?')) {
            document.getElementById('delete-form-' + id).submit();
        }
    }
</script>
{% endblock %}