{% extends 'base.html.twig' %}

{% block title %}Entreprises{% endblock %}

{% block body %}
<div class="search-bar">
    <input type="text" placeholder="Chercher par entreprise">
    <button class="filter-btn">
        <i class="fa fa-filter"></i>
    </button>
</div>

<h1>Entreprises</h1>

<div class="item-list">
    {% for item in companies %}
        <div class="item">
            <img src="" alt="{{ item.name }} logo" class="item-logo">
            <div class="item-details">
                <h2>{{ item.name }}</h2>
            </div>
            <div class="item-rating">
                {% if item.averageRating is defined %}
                    <div class="stars">
                        {% for i in 1..5 %}
                            {% if i <= item.averageRating|round(0, 'floor') %}
                                <i class="fas fa-star"></i>
                            {% elseif i - 0.5 <= item.averageRating %}
                                <i class="fas fa-star-half-alt"></i>
                            {% else %}
                                <i class="far fa-star"></i>
                            {% endif %}
                        {% endfor %}
                    </div>
                    <span class="rating-value">{{ item.averageRating|number_format(1) }}</span>
                {% else %}
                    <span class="no-rating">Non évalué</span>
                {% endif %}
            </div>
        </div>
    {% endfor %}
</div>

<div class="pagination">
    {{ knp_pagination_render(pagination, "pagination/pagination.html.twig") }}
</div>
{% endblock %}
