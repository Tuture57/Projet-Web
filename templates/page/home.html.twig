{% extends 'base.html.twig' %}

{% block title %}Trouvez votre stage{% endblock %}

{% block body %}
<div class="page-header mb-lg">
    <h1>Accueil 
        {# Affichage personnalisé selon le rôle de l'utilisateur #}
        {% set role = app.user.roles[0]|replace({'ROLE_': ''}) %}
        {% if role == 'ADMIN' %}
            administrateur
        {% elseif role == 'STUDENT' %}
            étudiant
        {% elseif role == 'PILOT' %}
            pilote
        {% else %}
            {{ role }}
        {% endif %}
    </h1>
</div>

<div class="d-flex flex-wrap gap-lg mb-lg">
    {# Bloc d'informations récentes #}
    <div class="card flex-1">
        <h2 class="mb-md text-primary">Dernières infos</h2>
        {% for info in latest_infos|default([
            {'icon': 'fas fa-sync-alt', 'content': 'Nous avons déplacé l\'ancienne base de données dans le nouveau serveur Meraki de l\'entreprise', 'date': '3 Fev. 2025 à 13:45'},
            {'icon': 'fas fa-sync-alt', 'content': 'Nous avons déplacé l\'ancienne base de données dans le nouveau serveur Meraki de l\'entreprise', 'date': '3 Fev. 2025 à 13:45'}
        ]) %}
            <div class="list-item p-sm rounded-md">
                <div class="d-flex align-center mb-xs">
                    <i class="{{ info.icon }} text-primary mr-sm"></i>
                    <span class="text-muted">le {{ info.date }}</span>
                </div>
                <p>{{ info.content }}</p>
            </div>
        {% endfor %}
    </div>

    {# Bloc d'offres de stage récentes #}
    <div class="card flex-1">
        <h2 class="mb-md text-primary">Offres de stage récentes</h2>
        {% for offer in recent_offers|default([
            {'title': 'Développeur web', 'description': 'Venez chez nous pour qu\'on vous exploite afin de réaliser nos projets web de nos clients.', 'expiry': '31 Jan. 2025'},
            {'title': 'Développeur web', 'description': 'Venez chez nous pour qu\'on vous exploite afin de réaliser nos projets web de nos clients.', 'expiry': '31 Jan. 2025'}
        ]) %}
            <div class="list-item p-sm rounded-md">
                <h3 class="mb-sm">{{ offer.title }}</h3>
                <p class="mb-sm">{{ offer.description }}</p>
                <span class="text-muted">Active jusqu'au {{ offer.expiry }}</span>
            </div>
        {% endfor %}
    </div>
</div>

{# Graphique de trafic du site #}
<div class="card p-md mb-lg">
    <h2 class="mb-md text-primary">Trafic du site</h2>
    <div class="data-visualization">
        <img src="{{ asset('images/stonks.jpg') }}" alt="Graphique de trafic" class="w-100" style="max-height: 300px; object-fit: contain;">
        <div class="legend d-flex justify-center gap-md mt-md">
            <span class="d-flex align-center"><i class="dot purple mr-xs"></i> Utilisateurs</span>
            <span class="d-flex align-center"><i class="dot orange mr-xs"></i> Offres de stages</span>
        </div>
    </div>
</div>
{% endblock %}