{% extends 'base.html.twig' %}

{% block title %}Pilotes{% endblock %}

{% block body %}
{# Barre de recherche #}
{% include 'partials/_search_bar.html.twig' with {
    'route_name': 'pilote',
    'placeholder': 'Rechercher par nom, prénom ou email',
    'active_filters': {
        'school': app.request.query.get('school'),
        'sortBy': app.request.query.get('sortBy')
    }
} %}

{# Panneau de filtres #}
{% include 'partials/_filter_panel.html.twig' with {
    'route_name': 'pilote',
    'filters': [
        {
            'name': 'school',
            'label': 'École',
            'placeholder': 'Tous les établissements',
            'options': schools
        }
    ],
    'sort_options': [
        {'value': 'lastName_asc', 'label': 'Nom (A-Z)'},
        {'value': 'lastName_desc', 'label': 'Nom (Z-A)'},
        {'value': 'firstName_asc', 'label': 'Prénom (A-Z)'},
        {'value': 'firstName_desc', 'label': 'Prénom (Z-A)'},
        {'value': 'school_asc', 'label': 'Établissement (A-Z)'},
        {'value': 'school_desc', 'label': 'Établissement (Z-A)'}
    ]
} %}

{# En-tête des résultats #}
{% include 'partials/_search_results_header.html.twig' with {
    'title': 'Pilotes',
    'items': pilots,
    'route_name': 'pilote',
    'entity_name_plural': 'pilotes',
    'action_button': is_granted('ROLE_ADMIN') ? {
        'route': 'pilote_new',
        'icon': 'fas fa-plus',
        'label': 'Ajouter un pilote'
    } : null
} %}

{% if pilots|length > 0 %}
    <div class="item-list">
        {% for item in pilots %}
            <a href="{{ path('pilote_show', {'id': item.id}) }}" class="item d-flex align-center">
                {% if item.imageName %}
                    <img src="{{ asset('uploads/pilots/' ~ item.imageName) }}" alt="{{ item.firstName }} {{ item.lastName }}" class="item-logo">
                {% else %}
                    <div class="item-logo-placeholder">
                        {{ item.firstName|first|upper }}{{ item.lastName|first|upper }}
                    </div>
                {% endif %}
                
                <div class="item-details flex-1">
                    <h2 class="m-0 mb-xs">{{ item.firstName }} {{ item.lastName }}</h2>
                    
                    {% if item.school %}
                        <div class="item-location">
                            <i class="fas fa-university"></i> {{ item.school }}
                        </div>
                    {% endif %}
                </div>
                
                <div class="item-rating">
                    <span class="badge badge-primary">Pilote</span>
                </div>
            </a>
        {% endfor %}
    </div>
    
    {# Pagination #}
    {{ knp_pagination_render(pilots, 'pagination/pagination.html.twig') }}
{% else %}

{% endif %}
{% endblock %}