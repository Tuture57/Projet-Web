{% extends 'base.html.twig' %}

{% block title %}{{ pilot.firstName }} {{ pilot.lastName }}{% endblock %}

{% block body %}
<div class="company-header mb-lg">
    <div class="back-button mb-md">
        <a href="{{ path('pilote') }}" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i> Retour aux pilotes</a>
    </div>
    
    {# Affichage du profil du pilote #}
    <div class="company-profile">
        <div class="company-logo-container">
            {% include 'partials/_image_display.html.twig' with {
                'entity': pilot,
                'upload_path': 'uploads/pilots',
                'alt': pilot.firstName ~ ' ' ~ pilot.lastName,
                'image_class': 'company-logo',
                'placeholder_class': 'company-logo-placeholder',
                'name': pilot.firstName ~ ' ' ~ pilot.lastName
            } %}
        </div>
        
        <div class="company-info">
            <h1>{{ pilot.firstName }} {{ pilot.lastName }}</h1>
            
            {# Actions administratives #}
            {% if is_granted('ROLE_ADMIN') %}
                <div class="admin-actions d-flex gap-sm">
                    <a href="{{ path('pilote_edit', {'id': pilot.id}) }}" class="btn btn-edit btn-sm">
                        <i class="fas fa-edit"></i> Modifier
                    </a>
                    
                    <a href="#" class="btn btn-danger btn-sm" onclick="confirmDelete({{ pilot.id }})">
                        <i class="fas fa-trash"></i> Supprimer
                    </a>
                </div>
                
                <form id="delete-form-{{ pilot.id }}" action="{{ path('pilote_delete', {'id': pilot.id}) }}" method="post" style="display: none;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ pilot.id) }}">
                </form>
            {% endif %}
            
            <div class="company-rating">
                <span class="badge badge-primary">Pilote</span>
            </div>
            
            {# Détails du pilote #}
            <div class="company-details">
                {% if pilot.school %}
                    <div class="detail-item">
                        <i class="fas fa-university"></i>
                        <span>{{ pilot.school }}</span>
                    </div>
                {% endif %}
                
                <div class="detail-item">
                    <i class="fas fa-envelope"></i>
                    <span>{{ pilot.email }}</span>
                </div>
            </div>
        </div>
    </div>
</div>

{# Informations complémentaires #}
<div class="card mb-lg">
    <h2 class="mb-md">Informations complémentaires</h2>
    <div class="description-content">
        {% if pilot.address is defined and pilot.address %}
            <div class="address-section mb-md">
                <h3><i class="fas fa-map-marker-alt"></i> Adresse</h3>
                <p>{{ pilot.address }}</p>
            </div>
        {% endif %}
    </div>
</div>

{# Script de confirmation de suppression #}
<script>
function confirmDelete(id) {
    if (confirm('Êtes-vous sûr de vouloir supprimer ce pilote ?')) {
        document.getElementById('delete-form-' + id).submit();
    }
}
</script>
{% endblock %}