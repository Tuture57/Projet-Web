{% extends 'base.html.twig' %}

{% block title %}Mes candidatures{% endblock %}

{% block body %}
<div class="page-header mb-lg">
    <h1>Mes candidatures</h1>
</div>

{# Barre de filtres pour les candidatures #}
<div class="filters-bar p-md rounded-lg mb-lg">
    <div class="filter-label mb-sm">Filtrer par statut :</div>
    <div class="filter-buttons d-flex gap-sm flex-wrap">
        {% set current_filters = app.request.query.all()['filters'] is defined ? app.request.query.all()['filters'] : [] %}
        
        {# Bouton pour afficher toutes les candidatures #}
        <a href="{{ path('candidature_index') }}" 
            class="filter-btn alt {% if current_filters is empty %}active{% endif %}">
            Toutes
        </a>
        
        {# Bouton pour filtrer les candidatures en attente #}
        <a href="{{ path('candidature_index', {
                'filters': 'Pending' in current_filters 
                    ? current_filters|filter(f => f != 'Pending') 
                    : current_filters|merge(['Pending'])
            }) }}" 
            class="filter-btn alt {% if 'Pending' in current_filters %}active{% endif %}">
            En attente
        </a>
        
        {# Bouton pour filtrer les candidatures acceptées #}
        <a href="{{ path('candidature_index', {
                'filters': 'Accepted' in current_filters 
                    ? current_filters|filter(f => f != 'Accepted') 
                    : current_filters|merge(['Accepted'])
            }) }}" 
            class="filter-btn alt {% if 'Accepted' in current_filters %}active{% endif %}">
            Acceptées
        </a>
        
        {# Bouton pour filtrer les candidatures refusées #}
        <a href="{{ path('candidature_index', {
                'filters': 'Rejected' in current_filters 
                    ? current_filters|filter(f => f != 'Rejected') 
                    : current_filters|merge(['Rejected'])
            }) }}" 
            class="filter-btn alt {% if 'Rejected' in current_filters %}active{% endif %}">
            Refusées
        </a>
    </div>
</div>

{% if applications|length > 0 %}
    <div class="application-list">
        {% set displayed_applications = false %}
        {% set active_filters = app.request.query.all()['filters'] is defined ? app.request.query.all()['filters'] : [] %}
        
        {% for application in applications %}
            {% if active_filters is empty or application.status in active_filters %}
                {% set displayed_applications = true %}
                {# Carte pour chaque candidature #}
                <div class="application-item shadow-sm">
                    <div class="application-header">
                        <div class="application-title">
                            <h2>{{ application.offer.title }}</h2>
                            <span class="status-badge 
                                {% if application.status == 'Accepted' %}status-accepted{% endif %}
                                {% if application.status == 'Pending' %}status-pending{% endif %}
                                {% if application.status == 'Rejected' %}status-rejected{% endif %}
                            ">
                                {% if application.status == 'Accepted' %}Acceptée{% endif %}
                                {% if application.status == 'Pending' %}En attente{% endif %}
                                {% if application.status == 'Rejected' %}Refusée{% endif %}
                            </span>
                        </div>
                        <div class="application-date text-muted">
                            Postulé le {{ application.applicationDate|date('d/m/Y') }}
                        </div>
                    </div>
                    
                    {# Informations sur l'entreprise #}
                    <div class="application-company mb-sm">
                        <i class="fas fa-building"></i>
                        {{ application.offer.company.name }}
                    </div>
                    
                    {# Dates du stage #}
                    <div class="application-dates">
                        <i class="fas fa-calendar-alt"></i>
                        {% if application.offer.startDate and application.offer.endDate %}
                            Du {{ application.offer.startDate|date('d/m/Y') }} au {{ application.offer.endDate|date('d/m/Y') }}
                        {% else %}
                            Dates non spécifiées
                        {% endif %}
                    </div>
                    
                    {# Boutons d'action pour la candidature #}
                    <div class="application-actions">
                        <a href="{{ path('offre_show', {'id': application.offer.id}) }}" class="btn btn-primary btn-sm">
                            <i class="fas fa-eye"></i> Voir l'offre
                        </a>
                        
                        <a href="{{ path('candidature_details', {'id': application.id}) }}" class="btn btn-info btn-sm">
                            <i class="fas fa-eye"></i> Voir les détails
                        </a>
                        
                        {% if application.status == 'Pending' %}
                            <a href="{{ path('candidature_annuler', {'id': application.id}) }}" class="btn btn-danger btn-sm" onclick="return confirm('Êtes-vous sûr de vouloir annuler cette candidature ?')">
                                <i class="fas fa-times"></i> Annuler
                            </a>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        {% endfor %}
        
        {# Message affiché quand aucune candidature ne correspond aux filtres #}
        {% if not displayed_applications %}
            <div class="no-offers bg-light rounded-lg p-xl text-center">
                <i class="far fa-file-alt"></i>
                <p class="mt-md">Aucune candidature ne correspond aux filtres sélectionnés</p>
            </div>
        {% endif %}
    </div>
{% else %}
    {# Message affiché quand l'utilisateur n'a pas encore de candidatures #}
    <div class="no-applications text-center p-xl bg-light rounded-lg shadow-sm">
        <i class="fas fa-inbox mb-md"></i>
        <p class="mb-md">Vous n'avez pas encore postulé à des offres de stage.</p>
        <a href="{{ path('offre') }}" class="btn btn-primary">
            Découvrir les offres
        </a>
    </div>
{% endif %}
{% endblock %}
