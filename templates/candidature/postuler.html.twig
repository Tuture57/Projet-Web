{% extends 'base.html.twig' %}

{% block title %}Postuler à l'offre{% endblock %}

{% block body %}
<div class="form-page">
    <div class="form-header">
        <h1>Postuler à l'offre : {{ offer.title }}</h1>
        <a href="{{ path('offre_show', {'id': offer.id}) }}" class="btn-back">
            <i class="fas fa-arrow-left"></i> Retour à l'offre
        </a>
    </div>

    <div class="card">
        <div class="offer-summary">
            <h2>Résumé de l'offre</h2>
            <div class="offer-details">
                <div class="detail-item">
                    <i class="fas fa-building"></i>
                    <span>{{ offer.company.name }}</span>
                </div>
                <div class="detail-item">
                    <i class="fas fa-calendar-alt"></i>
                    <span>Du {{ offer.startDate|date('d/m/Y') }} au {{ offer.endDate|date('d/m/Y') }}</span>
                </div>
                <div class="detail-item">
                    <i class="fas fa-money-bill-wave"></i>
                    <span>{{ offer.remuneration|number_format(2, ',', ' ') }} € / mois</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <h2>Formulaire de candidature</h2>
        
        {{ form_start(form, {'attr': {'class': 'application-form'}}) }}
            <div class="form-section">
                <div class="form-group">
                    {{ form_label(form.coverLetter) }} <span class="required">*</span>
                    {{ form_widget(form.coverLetter) }}
                    {{ form_errors(form.coverLetter) }}
                    <div class="form-help">Expliquez votre motivation, vos compétences pertinentes et pourquoi vous seriez un bon candidat pour ce stage.</div>
                </div>

                <div class="form-group">
                    {{ form_label(form.cvFile) }} <span class="required">*</span>
                    {{ form_widget(form.cvFile) }}
                    {{ form_errors(form.cvFile) }}
                    {{ form_help(form.cvFile) }}
                    
                    <div class="form-help">
                        <p><i class="fas fa-info-circle"></i> Veuillez télécharger votre CV au format PDF, DOC ou DOCX.</p>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary">
                    <i class="fas fa-paper-plane"></i> Envoyer ma candidature
                </button>
                <a href="{{ path('offre_show', {'id': offer.id}) }}" class="btn-secondary">
                    <i class="fas fa-times"></i> Annuler
                </a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
