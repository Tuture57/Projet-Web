<div class="filter-overlay" id="filterOverlay"></div>

<div class="search-bar">
    <form action="{{ path(route_name) }}" method="get" class="search-form">
        <div class="search-input-container">
            <button type="submit" class="search-submit-btn">
                <i class="fas fa-search search-icon"></i>
            </button>
            <input type="text" name="search" placeholder="{{ placeholder|default('Rechercher...') }}" class="integrated-input" value="{{ app.request.query.get('search') }}">
        </div>
        
        {# Préserver les filtres actifs lors d'une recherche #}
        {% for filter_name, filter_value in active_filters|default({}) %}
            {% if filter_value is not empty %}
                <input type="hidden" name="{{ filter_name }}" value="{{ filter_value }}">
            {% endif %}
        {% endfor %}
        
        <button type="button" class="filter-btn">
            <i class="fa fa-filter"></i>
        </button>
    </form>
</div>